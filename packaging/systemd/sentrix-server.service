[Unit]
Description=Sentrix server (agent ingest + dashboard)
Documentation=https://github.com/MerhiOPS/sentrix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentrix
Group=sentrix
EnvironmentFile=-/etc/default/sentrix-server
ExecStart=/usr/bin/sentrix-server serve --data /var/lib/sentrix $SENTRIX_SERVER_ARGS
Restart=on-failure
RestartSec=5s
# The server shuts down within 15 s (in-flight requests, final writes).
TimeoutStopSec=30s
StateDirectory=sentrix
StateDirectoryMode=0700
UMask=0077

# Hardening: the server needs its data directory and the network, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# Binding 443 instead of 8443 would need: AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
